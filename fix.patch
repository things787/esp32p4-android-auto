 static inline uint32_t millis_now(void)
 {
     return (uint32_t)(esp_timer_get_time() / 1000);
@@ -70,6 +78,9 @@ void vesc_lisp_panel_init(uint8_t target_vesc_id)
     if (!s_action_q) {
         s_action_q = xQueueCreate(VLP_ACTION_QUEUE_LEN, sizeof(vlp_action_t));
     }
+    if (!s_cmd_q) {
